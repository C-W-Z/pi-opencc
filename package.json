{
  "name": "pi-opencc",
  "version": "0.1.0",
  "description": "pi Fullscreen 輸入框的繁簡轉換與兩階段送出",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C-W-Z/pi-opencc.git"
  },
  "homepage": "https://pi.dev/packages/pi-opencc",
  "bugs": {
    "url": "https://github.com/C-W-Z/pi-opencc/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "opencc"
  ],
  "files": [
    "src/**/*.ts",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "opencc-js": "^1.4.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
